{
  "name": "mori-ui",
  "version": "0.0.1",
  "description": "Svelte 5 + Tailwind CSS v4 design system & component library, shared across spark / bonehub / zrr.dev",
  "license": "MIT",
  "author": "Zhan Rongrui <zrr1999@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morirun/mori-ui.git"
  },
  "homepage": "https://github.com/morirun/mori-ui",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
